import re
s=open('acct.js',encoding='utf-8',errors='replace').read()
# find mutation documents: "mutation" ... up to the matching "{"
hits=[]
for m in re.finditer(r'\bmutation\s*(\w+)?\s*\{', s):
    start=m.start(); brace=m.end()-1
    # naive balanced scan
    d=0; i=brace
    while i < len(s):
        if s[i]=='{': d+=1
        elif s[i]=='}':
            d-=1
            if d==0: break
        i+=1
    doc=s[start:i+1]
    # top-level field name
    inner=doc[brace+1:]
    fm=re.match(r'\s*(\w+)\s*(\(([^{}]*)\))?', inner)
    if not fm: continue
    fname=fm.group(1)
    args=fm.group(3) or ''
    argnames=re.findall(r'(?:^|,)\s*([A-Za-z_][A-Za-z0-9_]*)\s*:', args)
    hits.append((fname, tuple(sorted(set(argnames))), len(doc)))
seen={}
for f,a,l in hits:
    seen.setdefault((f,a), l)
print(f"{len(seen)} distinct mutation root fields\n")
idish=[]
for (f,a),l in sorted(seen.items()):
    marks=[n for n in a if re.search(r'(?i)(id$|^id|uuid|token|email|phone|code|hash|number)', n)]
    flag=''
    if marks and not f.lower().startswith(('create','submit','request','set','upload','process','update','cancel','schedule','persist','complete','revoke','delete','sign','resend','creategoogle','createfacebook','createpdf','createtax','createfinancing','createtracking','createpropert')):
        flag='  <== object-ish arg'
        idish.append((f,a,marks))
    print(f"{f:<38} {list(a)}{flag}")
print("\n--- candidate object-addressing ---")
for f,a,mk in idish: print(f,a,mk)
