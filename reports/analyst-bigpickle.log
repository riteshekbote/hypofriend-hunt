new = '''TABLE_ROW = re.compile(
    r'^\\|\\s*\\d+\\s*\\|\\s*(?P<title>[^|]{3,90}?)\\s*\\|\\s*\\*\\*VALID\\*\\*\\s*\\|'
    r'(?:\\s*(?P<cvss>[0-9.]+\\s*\\(?[A-Za-z]*\\)?|HIGH|MEDIUM|LOW|CRITICAL)?[^|]*\\|)?', re.I)
CVSS_NUM = re.compile(r'\\b(\\d\\.\\d)\\b')


def norm_title(t: str) -> str:
    """Collapse a title to a comparison key: lowercase, drop scores/severities/ids."""
    t = t.lower()
    t = re.sub(r'\\b\\d\\.\\d\\b', ' ', t)
    t = re.sub(r'\\b(high|medium|low|critical)\\b', ' ', t)
    t = re.sub(r'\\b[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\\b', ' ', t)
    t = re.sub(r'[^a-z0-9/._-]+', ' ', t)
    return re.sub(r'\\s+', ' ', t).strip()[:70]


def cmd_ledger(args):
    path = Path(args.path)
    if not path.exists():
        print(f"missing {path}")
        return 0
    text = path.read_text(encoding="utf-8", errors="ignore")
    lines = text.split("\\n")

    header = lines[0] if lines else ""
    runs = len(re.findall(r'lead\\(s\\) marked VALID', text))
    claimed = re.search(r'running count\\s+(\\d+)', header, re.I)
    claimed_n = int(claimed.group(1)) if claimed else None

    findings, untitled, prose, holds = {}, [], [], []

    def slot(title, line_no):
        key = norm_title(title) or "<no title recorded>"
        f = findings.setdefault(key, {"lines": [], "cvss": set(), "flags": set()})
        f["lines"].append(line_no)
        f["cvss"].update(CVSS_NUM.findall(title))
        low = title.lower()
        for name, pat in ALWAYS_REJECTED:
            if re.search(pat, low, re.I):
                f["flags"].add(name)
        return f

    for i, line in enumerate(lines, 1):
        s = line.strip().lstrip('- ').strip()
        if not s:
            continue
        has_valid = re.search(r'(?<!IN)\\bVALID\\b', s) and not re.search(r'\\bINVALID\\b', s)
        has_hold = re.search(r'\\bHOLD\\b', s)
        if not (has_valid or has_hold) or not VERDICT_LINE.search(s):
            continue
        if PROSE_VERDICT.search(s):
            prose.append((i, s[:110]))
            continue
        if has_hold:
            holds.append((i, s[:110]))

        m = TABLE_ROW.match(s)
        if m:
            slot(m.group("title"), i)
            if m.group("cvss"):
                slot(m.group("cvss"), i)
            continue

        # prose verdict: "- **Verdict: VALID** - Read-only: OPTIONS request ..."
        tail = re.split(r'(?i)verdict\\s*[:=]|\\*\\*VALID\\*\\*|\\*\\*HOLD\\*\\*', s, maxsplit=1)
        rest = (tail[-1] if len(tail) > 1 else "").strip(" -*\\u2014.:")
        rest = re.split(r'\\*\\*', rest)[0].strip(" -*\\u2014.:")
        if len(rest) < 12:
            untitled.append((i, s[:110]))
            continue
        slot(rest[:90], i)

    rejected = {k: f for k, f in findings.items() if f["flags"]}
    drift = {k: f for k, f in findings.items() if len(f["cvss"]) > 1}
    dupes = {k: f for k, f in findings.items() if len(f["lines"]) > 1}
    net = max(len(findings) - len(rejected), 0)
    total_lines = sum(len(f["lines"]) for f in findings.values())

    print(f"ledger: {path}")
    print(f"  header 'running count' : {claimed_n}")
    print(f"  triage runs logged    : {runs}   <- what the old counter counted")
    print(f"  VALID-ish lines       : {total_lines}")
    print(f"  distinct findings     : {len(findings)}")
    print(f"  ...in rejected classes: {len(rejected)}")
    print(f"  net reportable        : {net}")
    print(f"  HOLD counted as valid : {len(holds)}")
    print(f"  prose captured        : {len(prose)}")
    print(f"  verdicts with no title: {len(untitled)}")

    if rejected:
        print("  -- always-rejected classes --")
        for k, f in sorted(rejected.items()):
            print(f"   {k} [{','.join(sorted(f['flags']))}] lines {f['lines']}")
    if drift:
        print("  -- same finding scored differently across runs --")
        for k, f in drift.items():
            print(f"   {k} :: {sorted(f['cvss'])} lines {f['lines']}")
    if dupes:
        print(f"  -- re-validated in multiple runs: {len(dupes)} --")
        for k, f in sorted(dupes.items()):
            print(f"   x{len(f['lines'])} {f['lines']} :: {k}")
    if prose:
        print("  -- prose mistaken for a verdict --")
        for i, s in prose:
            print(f"   L{i} {s}")
    if untitled:
        print("  -- verdict with no finding recorded --")
        for i, s in untitled[:10]:
            print(f"   L{i} {s}")
    if claimed_n is not None and claimed_n != net:
        print(f"  !! header claims {claimed_n}, computed {net}")
    return 1 if (prose or rejected or untitled or holds) else 0

'''.split('\n')
p.write_text('\n'.join(head + new + tail))
