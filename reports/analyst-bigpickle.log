import re
s=open('acct.js',encoding='utf-8',errors='replace').read().replace('\\n','\n')
def doc(field):
    m=re.search(r'\bmutation\s*(\w+)?\s*\{', s)
    out=[]
    for m in re.finditer(r'\bmutation\s*(\w+)?\s*\{', s):
        i=m.end()-1; d=0; j=i
        while j<len(s):
            if s[j]=='{': d+=1
            elif s[j]=='}':
                d-=1
                if d==0: break
            j+=1
        body=s[m.end():j]
        if re.search(r'\b'+field+r'\b', body[:400]):
            out.append(s[m.start():j+1].strip())
    return out
for f in ['jiyuCalculate','createUploadUrl','sendVerifiedListingEmail','selectOffer']:
    for d in doc(f)[:1]:
        print('='*90); print(d[:1500])
