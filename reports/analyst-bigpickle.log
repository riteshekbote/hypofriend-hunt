    pre=s[m.end():i]
    fname=re.findall(r'(\w+)\s*$', pre.replace('\\n',' '))
    fname=fname[-1] if fname else '?'
    argnames=tuple(sorted(set(re.findall(r'(?:^|[,{])\s*([A-Za-z_][A-Za-z0-9_]*)\s*:', args.replace('\\n',' ')))))
    out.setdefault((fname,argnames), (len(args), m.start()))
print(f"{len(out)} distinct mutation root fields with args\n")
cand=[]
for (f,a),(l,pos) in sorted(out.items()):
    idish=[n for n in a if re.search(r'(?i)(^id$|Id$|uuid|token|hash)', n)]
    tag=('   <== '+str(idish)) if idish else ''
    if idish: cand.append((f,a,idish))
    print(f"{f:<44} {list(a)}{tag}")
print("\n=== object-addressing candidates ===")
for f,a,i in cand: print(f"{f} {list(a)} {i}")
